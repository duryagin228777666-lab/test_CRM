# Токен бота от @BotFather. Пустой — веб-CRM работает, бот не запускается.
BOT_TOKEN=

# Куда слать уведомления о новых лидах (chat id через запятую). Узнать свой id: команда /id в боте.
MANAGER_CHAT_IDS=

# Публичный адрес CRM — для ссылок на карточку лида в уведомлениях.
PUBLIC_URL=http://localhost:8000

# Вход в CRM
ADMIN_LOGIN=demo
ADMIN_PASSWORD=demo
# Секрет для подписи cookie сессии: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me

DB_PATH=data/crm.db
TIMEZONE=Europe/Moscow

# 1 — при пустой базе создать несколько демо-лидов с тегом «демо»
SEED_DEMO=0

# Если api.telegram.org недоступен: socks5://127.0.0.1:1080 или http://host:port
TELEGRAM_PROXY=
